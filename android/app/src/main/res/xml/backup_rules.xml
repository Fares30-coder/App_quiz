<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 et moins : la session Supabase (flutter_secure_storage) n'est
     pas sauvegardée ; ses clés Keystore ne seraient pas restaurables. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>
